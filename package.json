{
  "name": "notes",
  "version": "1.0.0",
  "description": "Write web-friendly notes quickly in Markdown.",
  "main": "index.js",
  "scripts": {
    "e2e": "testcafe chrome -L integration/home.spec.ts",
    "e2e:ci": "testcafe chrome:headless integration/home.spec.ts --app 'npm run start'",
    "sidebar": "npx tsx --watch sidebar.ts",
    "serve": "browser-sync start --server public --files public",
    "start": "npm run sidebar & npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simboonlong/notes.git"
  },
  "author": "Sim Boon Long",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/simboonlong/notes/issues"
  },
  "homepage": "https://github.com/simboonlong/notes#readme",
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "marked": "^15.0.2",
    "testcafe": "^3.7.0"
  }
}
